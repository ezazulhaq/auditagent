# ==============================================================================
# AuditAgent Frontend Dev Server Dockerfile
# Provides instant Vite Hot Module Replacement (HMR) on port 5173
# ==============================================================================

FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
