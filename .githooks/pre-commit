#!/bin/sh
#
# AuditAgent Pre-Commit Guardrails
#
# 1. Protected Branch Guard:
#    Blocks direct commits to protected branches ('dev', 'master', 'main').
#    All code must be developed on isolated feature branches and merged via PR to 'dev'.
#
# 2. Documentation Guard:
#    Blocks commits containing staged implementation, configuration, rules, skills,
#    scripts, or build changes when no Markdown document under doc/ is staged.
#

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# ---------------------------------------------------------------------------
# Guardrail 1: Protected Branch Guard
# ---------------------------------------------------------------------------
current_branch=$(git symbolic-ref --short HEAD 2>/dev/null || git branch --show-current 2>/dev/null || true)

if [ -n "$current_branch" ]; then
  case "$current_branch" in
    dev|master|main)
      if [ "${AUDITAGENT_ALLOW_PROTECTED_COMMIT:-}" = "1" ]; then
        echo "AuditAgent branch guard warning: Direct commit to protected branch '$current_branch' allowed by AUDITAGENT_ALLOW_PROTECTED_COMMIT=1."
      else
        cat >&2 <<EOF
========================================================================
[BLOCKED] Direct commit to protected branch '$current_branch' is forbidden!
========================================================================
AuditAgent branching policy strictly forbids committing directly to 'dev',
'master', or 'main'. All work must be developed on an isolated feature branch
and submitted via a Pull Request targeting 'dev' (--base dev).

To resolve this:
  1. Create a dedicated feature branch off '$current_branch':
       git checkout -b <type>/<descriptive-kebab-name>
     (e.g., feat/user-auth, fix/finding-sync, chore/git-hooks)
  2. Review your staged changes and commit them on the feature branch:
       git commit ...
  3. Push to remote and open a Pull Request:
       git push -u origin <branch-name>
       gh pr create --base dev

Emergency override (restricted to emergency fixes/release synchronization):
  AUDITAGENT_ALLOW_PROTECTED_COMMIT=1 git commit ...
========================================================================
EOF
        exit 1
      fi
      ;;
  esac
fi

# ---------------------------------------------------------------------------
# Guardrail 2: Documentation Guard
# ---------------------------------------------------------------------------
if [ "${AUDITAGENT_SKIP_DOCS_CHECK:-}" = "1" ]; then
  echo "AuditAgent documentation check skipped by AUDITAGENT_SKIP_DOCS_CHECK=1."
  exit 0
fi

changed_paths=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$changed_paths" ]; then
  exit 0
fi

requires_docs=0
docs_changed=0

while IFS= read -r path; do
  case "$path" in
    doc/*.md)
      docs_changed=1
      ;;
    src/main/*|frontend/src/*|rules/*|.auditagent/skills/*|.agents/*|scripts/*|pom.xml|frontend/package.json|frontend/package-lock.json|frontend/vite.config.js|src/main/resources/application.yaml|run.sh|run-dev.sh|.devcontainer/*|.githooks/*)
      requires_docs=1
      ;;
  esac
done <<EOF
$changed_paths
EOF

if [ "$requires_docs" -eq 1 ] && [ "$docs_changed" -ne 1 ]; then
  cat >&2 <<'EOF'
AuditAgent documentation check failed.

The staged change modifies implementation, configuration, rules, skills, or
runtime behavior, but no Markdown file under doc/ is staged.

Review doc/README.md and update every affected guide. At minimum, consider:
  - doc/03-feature-catalog.md
  - doc/07-api-reference.md
  - doc/08-data-and-persistence.md
  - doc/10-security-model.md
  - doc/11-setup-configuration-operations.md
  - doc/14-change-guide.md
  - doc/15-source-inventory-and-glossary.md

If the change is demonstrably documentation-neutral, retry explicitly with:
  AUDITAGENT_SKIP_DOCS_CHECK=1 git commit ...
and record the reason in the change handoff.
EOF
  exit 1
fi

exit 0
