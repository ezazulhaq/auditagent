# ==============================================================================
# AuditAgent Environment Configuration Template (.env.example)
# Copy this file to .env before starting the application or docker compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL / Relational & Memory Storage)
# ------------------------------------------------------------------------------
# PostgreSQL (JPA / Relational Storage & Native FTS tsvector Memory)
POSTGRES_URL=jdbc:postgresql://localhost:5432/auditagent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOSTNAME=localhost
POSTGRES_PORT=5432
POSTGRES_DB=auditagent

# Legacy DuckDB (Retained for backwards-compatibility fallback only; memory is consolidated to PostgreSQL)
# AUDITAGENT_DB_PATH=audit_reports.duckdb

# ------------------------------------------------------------------------------
# 1b. RabbitMQ Task Broker & Worker Deployment Mode
# ------------------------------------------------------------------------------
# Deployment Mode: 'all' (unified Web + Worker), 'web' (API ingress only), or 'worker' (background task processor)
AUDITAGENT_MODE=all
AUDITAGENT_WORKER_ENABLED=true

# RabbitMQ AMQP Broker Connection
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=auditagent
RABBITMQ_PASSWORD=auditagent
RABBITMQ_PREFETCH=2
RABBITMQ_AUTO_STARTUP=true

# RabbitMQ Management Web UI Port (Docker Compose)
RABBITMQ_MANAGEMENT_PORT=15672

# ------------------------------------------------------------------------------
# 1c. Supabase Storage & Services Integration
# ------------------------------------------------------------------------------
# Supabase API Gateway URL (self-hosted Supabase default is http://localhost:8000)
SUPABASE_URL=http://localhost:8000

# Supabase Service Role Key (required for Storage bucket operations and Realtime broadcasting)
SUPABASE_SERVICE_KEY=

# Supabase Storage bucket for durable PDF/Markdown audit reports and artifacts
SUPABASE_STORAGE_BUCKET=auditagent-artifacts

# ------------------------------------------------------------------------------
# 2. LLM / AI Model Provider Configuration
# ------------------------------------------------------------------------------
# User BYOK (Bring Your Own Key) enforcement:
# When true, users must provide their own OpenRouter / OpenAI-compatible API key and model upon login
AUDITAGENT_LLM_MODE=user
AUDITAGENT_LLM_USER_KEYS_REQUIRED=true

# Provider mode (default: openai-compatible)
AUDITAGENT_LLM_PROVIDER=openai-compatible

# Server-level fallback API Key (optional when AUDITAGENT_LLM_USER_KEYS_REQUIRED=true)
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here

# Base URL for the OpenAI-compatible endpoint
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Primary LLM model for vulnerability triage and remediation agent
PROVIDER_MODEL=openai/gpt-6-luna
OPENAI_MODEL_NAME=openai/gpt-6-luna

# Optional supervisor model override (for multi-agent supervisor node)
SUPERVISOR_MODEL_NAME=

# ------------------------------------------------------------------------------
# 2b. TypeSafe Jev Model Configuration (Finding Triage & Supervisor Routing)
# ------------------------------------------------------------------------------
# Master switch enabling TypeSafe Jev non-autoregressive decision model integration
AUDITAGENT_JEV_ENABLED=true

# Jev endpoint base URL (defaults to OpenRouter, /systemone endpoint appended automatically)
AUDITAGENT_JEV_BASE_URL=https://openrouter.ai/api/v1

# API key for Jev calls (leave blank to reuse OPENAI_API_KEY)
AUDITAGENT_JEV_API_KEY=

# Jev model identifier on OpenRouter
AUDITAGENT_JEV_MODEL=typesafe/jev-1.14

# HTTP client timeout in milliseconds and retry count before falling back to chat model
AUDITAGENT_JEV_TIMEOUT_MS=3000
AUDITAGENT_JEV_MAX_RETRIES=1

# Pre-flight finding triage (detects false positives and test mocks post-scan)
AUDITAGENT_JEV_TRIAGE_ENABLED=true
AUDITAGENT_JEV_TRIAGE_CONFIDENCE=0.75
AUDITAGENT_JEV_TRIAGE_CRITICAL_CONFIDENCE=0.95

# Supervisor routing acceleration (fast-path deterministic choice routing)
AUDITAGENT_JEV_SUPERVISOR_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Security Scanner (Semgrep CLI) Configuration
# ------------------------------------------------------------------------------
AUDITAGENT_SCANNER_TIMEOUT_SECONDS=900
AUDITAGENT_SCANNER_HEARTBEAT_SECONDS=15
AUDITAGENT_SCANNER_MAX_TARGET_BYTES=500000
AUDITAGENT_SCANNER_MAX_MEMORY_MB=1024
AUDITAGENT_SCANNER_RULE_TIMEOUT_SECONDS=2

# ------------------------------------------------------------------------------
# 4. Agent Execution & Docker Sandboxing
# ------------------------------------------------------------------------------
# Set to true to execute agent build/test/lint commands inside an isolated Docker container
AUDITAGENT_SANDBOX_ENABLED=false
AUDITAGENT_SANDBOX_IMAGE=auditagent-sandbox:latest
AUDITAGENT_SANDBOX_MEMORY=2g
AUDITAGENT_SANDBOX_CPU=2.0

# ------------------------------------------------------------------------------
# 5. Agent Memory & Context Compression
# ------------------------------------------------------------------------------
AUDITAGENT_MEMORY_SUMMARIZATION=true
AUDITAGENT_MAX_TOOL_OUTPUT_CHARS=2000

# ------------------------------------------------------------------------------
# 6. GitHub App Integration (OAuth, Repositories & PR Creation)
# ------------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# GitHub App RSA private key (PEM string or escaped content)
GITHUB_APP_PRIVATE_KEY=/app/.auditagent/private-key.pem

# Webhook secret configured in your GitHub App settings (generate: openssl rand -hex 32)
GITHUB_APP_WEBHOOK_SECRET=

# AES-GCM token encryption key for storing tokens securely (generate: openssl rand -base64 48)
AUDITAGENT_TOKEN_ENCRYPTION_KEY=

# Application & OAuth Callback URLs
GITHUB_APP_CALLBACK_URL=http://localhost:8173/api/auth/github/callback
AUDITAGENT_FRONTEND_URL=http://localhost:5173
GITHUB_APP_INSTALLATION_URL=https://github.com/apps/your-app-slug/installations/new

# GitHub API & OAuth endpoints (override for GitHub Enterprise if applicable)
GITHUB_API_URL=https://api.github.com
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_VERSION=2026-03-10

# Isolated workspaces directory on host for Git clones and branches
AUDITAGENT_WORKSPACE_ROOT=/tmp/auditagent-workspaces

# ------------------------------------------------------------------------------
# 7. Security & Session Settings
# ------------------------------------------------------------------------------
# Set to true in production when running behind HTTPS
AUDITAGENT_SECURE_COOKIES=false
AUDITAGENT_SESSION_HOURS=24