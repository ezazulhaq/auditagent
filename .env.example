# ==============================================================================
# AuditAgent Docker Compose Environment Configuration
# Copy this file to .env before starting docker compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOSTNAME=your.domain.com
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. AuditAgent Application Settings
# ------------------------------------------------------------------------------
AUDITAGENT_PORT=8173
SPRING_PROFILES_ACTIVE=local

# ------------------------------------------------------------------------------
# 3. LLM / AI Model Provider Configuration
# ------------------------------------------------------------------------------
# API Key for OpenAI, OpenRouter, or Gemini OpenAI-compatible proxy
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here

# Base URL for the OpenAI-compatible endpoint (e.g. OpenRouter or Gemini)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Primary model name for conversational triage and remediation agent
PROVIDER_MODEL=anthropic/claude-3.5-sonnet
OPENAI_MODEL_NAME=anthropic/claude-3.5-sonnet

# Optional supervisor model override for multi-agent graph routing
SUPERVISOR_MODEL_NAME=

# LLM provider type
AUDITAGENT_LLM_PROVIDER=openai-compatible

# ------------------------------------------------------------------------------
# 4. GitHub App Integration Credentials
# ------------------------------------------------------------------------------
# GitHub App ID and OAuth Client credentials
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# RSA Private Key for the GitHub App (PEM content or escaped string)
GITHUB_APP_PRIVATE_KEY=
# Or mounted path inside the container:
# GITHUB_APP_PRIVATE_KEY_PATH=/etc/auditagent/secrets/github-app.private-key.pem

# Webhook HMAC Secret (generate via: openssl rand -hex 32)
GITHUB_APP_WEBHOOK_SECRET=

# High-entropy token encryption key (generate via: openssl rand -base64 48)
AUDITAGENT_TOKEN_ENCRYPTION_KEY=

# Public URLs (adjust for production domain)
GITHUB_APP_CALLBACK_URL=http://localhost:8173/api/auth/github/callback
AUDITAGENT_FRONTEND_URL=http://localhost:8173
GITHUB_APP_INSTALLATION_URL=https://github.com/apps/your-auditagent-app/installations/new

# Security options
AUDITAGENT_SECURE_COOKIES=false
AUDITAGENT_SESSION_HOURS=24

# ------------------------------------------------------------------------------
# 5. Scanner & Agent Sandboxing
# ------------------------------------------------------------------------------
AUDITAGENT_SCANNER_TIMEOUT_SECONDS=900
AUDITAGENT_SCANNER_HEARTBEAT_SECONDS=15

# Set to true to execute agent shell commands inside an isolated Docker sandbox
AUDITAGENT_SANDBOX_ENABLED=false
AUDITAGENT_SANDBOX_IMAGE=auditagent-sandbox:latest
AUDITAGENT_SANDBOX_MEMORY=2g
AUDITAGENT_SANDBOX_CPU=2.0

# ------------------------------------------------------------------------------
# 6. Optional Services & Tools (Dev Frontend & pgAdmin)
# ------------------------------------------------------------------------------
FRONTEND_DEV_PORT=5173
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@auditagent.local
PGADMIN_PASSWORD=admin
